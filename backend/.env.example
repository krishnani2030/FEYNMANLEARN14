# Database
MONGODB_URI=mongodb://localhost:27017/feynman-learn

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Authentication
# Provide either GOOGLE_OAUTH_CLIENT_ID or the legacy GOOGLE_CLIENT_ID value.
# GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_ID=legacy-client-id.apps.googleusercontent.com
JWT_SECRET=development-jwt-secret
JWT_EXPIRES_IN=7d

# Google Meet service account (optional but required for automatic Meet links)
# GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account@project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nABC...\n-----END PRIVATE KEY-----\n"
# GOOGLE_CALENDAR_ID=primary
# GOOGLE_CALENDAR_TIMEZONE=UTC

# Email delivery (optional, required for enrollment/reminder emails)
# EMAIL_SERVICE=gmail
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASS=your-app-password
# EMAIL_FROM="Feynman Learn <no-reply@feynmanlearn.com>"