# Database
MONGODB_URI=mongodb://localhost:27017/feynman-learn

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Authentication
JWT_SECRET=development-jwt-secret
JWT_EXPIRES_IN=7d

# Email verification & notifications (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM="Feynman Learn <no-reply@feynmanlearn.com>"

# WebRTC live sessions
# Set to a unique string to sign join tokens (falls back to JWT_SECRET if omitted)
WEBRTC_SECRET=change-me-webrtc-secret

# Optional system notification identity
SYSTEM_USER_EMAIL=notifications@feynmanlearn.local
SYSTEM_USER_NAME=Feynman
SYSTEM_USER_PASSWORD=StrongSystemPassword123
