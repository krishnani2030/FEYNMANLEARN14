{
  "name": "feynman-learn-fullstack",
  "version": "1.0.0",
  "description": "Full-stack MERN application for peer-to-peer learning using the Feynman Technique",
  "main": "backend/server.js",
  "scripts": {
    "start": "cd backend && npm start",
    "frontend": "cd frontend && npm run dev",
    "dev": "cd backend && PORT=5050 nodemon server.js",
    "test": "echo 'No tests defined yet'",
    "run": "concurrently \"npm run dev\" \"npm run frontend\"",
    "seed": "cd backend && npm run seed",
    "install-backend": "cd backend && npm install",
    "install-frontend": "cd frontend && npm install",
    "install-all": "npm run install-backend && npm run install-frontend",
    "build": "echo 'Frontend is vanilla JS - no build needed'"
  },
  "keywords": [
    "education",
    "learning",
    "feynman",
    "mern",
    "fullstack"
  ],
  "author": "Your Name",
  "license": "MIT",
  "engines": {
    "node": ">=14.0.0"
  },
  "dependencies": {
    "socket.io": "^4.8.1"
  }
}
